# Frontend Environment Variables Template
# When deploying to Vercel, set these in Project Settings -> Environment Variables.
# In local development, you can create a .env file or leave them empty to fallback to localhost.

# Backend API base URL (e.g. https://your-backend.onrender.com/api or http://localhost:8000/api)
VITE_API_URL=http://localhost:8000/api

# WebSocket Server URL (e.g. wss://your-backend.onrender.com or ws://localhost:8000)
VITE_WS_URL=ws://localhost:8000

# Media Base URL (Optional - defaults to {backend}/media/artists/)
VITE_MEDIA_URL=http://localhost:8000/media/artists/
